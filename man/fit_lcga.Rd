\donttest{
set.seed(1)
n <- 400
cls <- rbinom(n, 1, 0.5)
eta <- outer(ifelse(cls == 1, 0.0, -0.8), rep(1, 4)) +
  outer(ifelse(cls == 1, 1.1, -0.1), 0:3)
y <- matrix(rbinom(n * 4, 1, plogis(eta)), n, 4)
fit <- fit_lcga(y, times = 4, n_classes = 2, n_init = 5, random_state = 1)
fit
}
